# ─────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — Club Fitting Directory
#
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git (it's in .gitignore).
#
# Where to find these values:
#   Supabase project → Settings → API
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─────────────────────────────────────────────────────────
# SERVER-ONLY (admin) — never prefix these with NEXT_PUBLIC_.
# They must NOT be exposed to the browser.
#   SUPABASE_SERVICE_ROLE_KEY: Supabase → Settings → API → service_role (secret)
#   ADMIN_PASSWORD: any strong password you choose; used to log into /admin
# Add both in Vercel → Settings → Environment Variables too (then redeploy).
# ─────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
ADMIN_PASSWORD=choose-a-strong-password

# ─────────────────────────────────────────────────────────
# NEWSLETTER (beehiiv) — powers the email signup forms.
#   BEEHIIV_API_KEY: beehiiv → Settings → Integrations → API → create key.
#     (Requires a paid beehiiv plan with API access.)
#   BEEHIIV_PUBLICATION_ID: the publication to add subscribers to.
#     "The Tuxedo Collective" = pub_56f4a012-0a7f-4f0b-905f-85e3e1215a3c
# Server-only — never prefix with NEXT_PUBLIC_. Add both in Vercel too.
# ─────────────────────────────────────────────────────────
BEEHIIV_API_KEY=your-beehiiv-api-key-here
BEEHIIV_PUBLICATION_ID=pub_56f4a012-0a7f-4f0b-905f-85e3e1215a3c

# ─────────────────────────────────────────────────────────
# BOOKING ENGINE ("Request a Fitting") — emails you each new lead.
#   RESEND_API_KEY: resend.com → API Keys → create. Free tier ~3k emails/mo.
#     If unset, requests are STILL saved to the database — only the email
#     notification is skipped. So the feature works before you add this.
#   BOOKING_NOTIFY_EMAIL: where leads are sent (defaults to the founder inbox).
#     With Resend's test sender, this must be the email you signed up to Resend with.
#   BOOKING_FROM_EMAIL (optional): branded "From" once you verify a domain in
#     Resend, e.g. "Club Fitting Directory <bookings@clubfittingdirectory.com>".
#     Leave unset to use Resend's shared testing sender.
# Server-only — never prefix with NEXT_PUBLIC_. Add to Vercel too (then redeploy).
# ─────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key-here
BOOKING_NOTIFY_EMAIL=jamesbradbeer3@gmail.com
# BOOKING_FROM_EMAIL=Club Fitting Directory <bookings@clubfittingdirectory.com>

# ─────────────────────────────────────────────────────────
# STRIPE — powers Verified badge payments ($49/mo or $499/yr).
#   STRIPE_SECRET_KEY: Stripe → Developers → API keys. Use the TEST key
#     (sk_test_…) locally; the LIVE key only in Vercel.
#   STRIPE_PRICE_ID_MONTHLY / STRIPE_PRICE_ID_ANNUAL: the two prices from the
#     Stripe dashboard. Each accepts a price id (price_…) or a product id
#     (prod_…) — for a product, the matching active recurring price is used.
#   STRIPE_WEBHOOK_SECRET: Stripe → Developers → Webhooks → your endpoint →
#     signing secret (whsec_…). Locally, use the secret printed by
#     `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Server-only — never prefix with NEXT_PUBLIC_. Add all four in Vercel too.
# ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-test-key-here
STRIPE_PRICE_ID_MONTHLY=price_monthly-id-here
STRIPE_PRICE_ID_ANNUAL=price_annual-id-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ─────────────────────────────────────────────────────────
# ON-DEMAND REVALIDATION — keeps the site cheap AND fresh.
#   Shop pages cache for 30 days to keep Vercel costs low. This secret lets a
#   Supabase Database Webhook tell the site "this shop changed, rebuild just its
#   pages now" instead of waiting out the cache. Without it, edits can take up to
#   30 days to appear, AND the endpoint refuses all requests (returns 500).
#   Generate one with:  openssl rand -hex 32
#   The SAME value must be set in THREE places to match:
#     1. Vercel → Settings → Environment Variables (so the endpoint knows it)
#     2. Supabase → Database → Webhooks → your "shops" webhook → HTTP header
#          Authorization: Bearer <the-secret>
#     3. (optional) here in .env.local, for local testing
# Server-only — never prefix with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────
REVALIDATE_SECRET=generate-with-openssl-rand-hex-32
