# Dependencies — installed automatically, no need to track
node_modules/
.pnp
.pnp.js

# Build output — generated at deploy time
.next/
out/
build/
dist/

# Environment variables — contains secrets, NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
dist/
*.egg

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Old pre-rebuild project backup (superseded by git history; not part of the app)
Club fitting directory claude */

# Local editor/launch config (not needed in the repo)
.claude/launch.json

# Outreach engine — local state (checkpoints, verification CSVs contain PII, OAuth token)
outreach/checkpoints/
outreach/verification/
outreach/.gmail_token.json

# Search Console service-account key — secret, NEVER commit (see tasks/gsc-api-setup.md)
gsc-service-account.json

# Generated GSC exports — refreshed by scripts/gsc_pull.py, do not commit snapshots
tasks/gsc-latest/

# Python virtualenvs
/.venv/
venv/

# Vercel local project link (machine-specific credentials)
/.vercel/

# Local agent caches
/.agents/

# Downloaded export archives (e.g. GSC zips)
*.zip

# Installed third-party Claude skills — only the project's own skill is tracked
.claude/skills/*
!.claude/skills/fitter-outreach/

# Discovery pipeline — secrets and raw scrape output (review/ IS committed)
discovery/.env
discovery/raw/
discovery/checkpoints/

# Hyperframes launch-video output (binary media, regenerable)
brag-output*/
